# Configuração de Banco de Dados
# Para SQLite local: file:./dev.db
# Para PostgreSQL de produção: postgresql://postgres:senha@localhost:5432/feedback_loja?schema=public
DATABASE_URL="file:./dev.db"

# Segredo de Assinatura de Sessões (mínimo 32 caracteres em produção)
JWT_SECRET="gere_uma_chave_secreta_com_pelo_menos_32_caracteres_aleatorios"

# URL pública da aplicação (usada nos links e QR Codes)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Credenciais iniciais para o primeiro seed administrativo (nunca exponha em produção)
ADMIN_INITIAL_EMAIL="admin@loja.com"
ADMIN_INITIAL_PASSWORD="DefinaUmaSenhaForteAqui123!"
ADMIN_INITIAL_NAME="Administrador Geral"
